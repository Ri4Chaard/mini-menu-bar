{
  "name": "mini-menu-bar",
  "version": "0.3.0",
  "description": "A lightweight macOS menu bar hub for recent screenshots and a countdown timer",
  "main": "./out/main/index.js",
  "author": "Yaroslav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ri4Chaard/mini-menu-bar.git"
  },
  "homepage": "https://github.com/Ri4Chaard/mini-menu-bar#readme",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build": "npm run typecheck && electron-vite build && node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --mac --arm64 --x64",
    "package:dir": "npm run build && electron-builder --mac --dir",
    "icons": "node scripts/make-icons.mjs",
    "clean": "rm -rf out release latest.json *.tsbuildinfo test-results",
    "release:check": "node scripts/check-release-version.mjs",
    "release:manifest": "node scripts/make-release-manifest.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "menubar": "^9.5.3",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
